# API base URL (production)
#
# Separate deployments (recommended):
#   VITE_API_URL=https://your-api-project.vercel.app/api/v1
#
# Single-domain proxy (web rewrites /api/* to the API project):
#   VITE_API_URL=/api/v1
#
# Local dev: leave unset — Vite proxies /api to localhost:3000
VITE_API_URL=https://your-api-project.vercel.app/api/v1

# Optional error tracking — https://sentry.io
# Leave unset to disable; the app stays silent without a DSN.
VITE_SENTRY_DSN=