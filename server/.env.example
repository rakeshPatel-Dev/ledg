# Required
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ledg
MONGODB_DB_NAME=ledg

# BetterAuth — self-hosted auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS — comma-separated allowed web origins (required in production)
# Separate deployments:
#   CORS_ORIGIN=https://your-web-project.vercel.app
# Custom domain:
#   CORS_ORIGIN=https://ledg.app,https://www.ledg.app
CORS_ORIGIN=https://your-web-project.vercel.app

# Only needed for local dev (Vercel sets PORT automatically)
PORT=3000
