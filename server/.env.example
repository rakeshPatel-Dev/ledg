# Required
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ledg
MONGODB_DB_NAME=ledg

# Clerk — get from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# CORS — comma-separated allowed web origins (required in production)
# Separate deployments:
#   CORS_ORIGIN=https://your-web-project.vercel.app
# Custom domain:
#   CORS_ORIGIN=https://ledg.app,https://www.ledg.app
CORS_ORIGIN=https://your-web-project.vercel.app

# Only needed for local dev (Vercel sets PORT automatically)
PORT=3000
